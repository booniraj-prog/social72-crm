}

model Expense {
  id           String    @id @default(uuid())
  claimantId   String    @map("claimant_id")
  approverId   String?   @map("approver_id")
  clientId     String?   @map("client_id")
  engagementId String?   @map("engagement_id")
  vendorId     String?   @map("vendor_id")
