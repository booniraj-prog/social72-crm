model Import {
  id             String   @id @default(uuid())
  campaignId     String   @map("campaign_id")
  uploadedBy     String   @map("uploaded_by")
  filename       String
  status         String
  totalRows      Int      @default(0) @map("total_rows")
  importedRows   Int      @default(0) @map("imported_rows")
  duplicateRows  Int      @default(0) @map("duplicate_rows")
  invalidRows    Int      @default(0) @map("invalid_rows")
  rejectedRows   Int      @default(0) @map("rejected_rows")
  columnMap      Json?    @map("column_map")
  createdAt      DateTime @default(now()) @map("created_at")

  campaign Campaign      @relation(fields: [campaignId], references: [id])
  uploader User          @relation(fields: [uploadedBy], references: [id])
  errors   ImportError[]

  @@map("imports")
}

model ImportError {
  id         String @id @default(uuid())
  importId   String @map("import_id")
  rowNumber  Int    @map("row_number")
  raw        Json?
  errors     Json

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("import_errors")
}

model Notification {
