model Invoice {
  id          String    @id @default(uuid())
  number      String    @unique
  clientId    String    @map("client_id")
  leadId      String?   @map("lead_id")
  engagementId String?  @map("engagement_id")
  ownerUserId String?   @map("owner_user_id")
  kind        String    @default("INVOICE")
  status      String    @default("DRAFT")
  issueDate   DateTime  @default(now()) @map("issue_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  subtotal    Decimal   @default(0) @db.Decimal(14, 2)
  gstPct      Decimal   @default(18) @map("gst_pct") @db.Decimal(5, 2)
  total       Decimal   @default(0) @db.Decimal(14, 2)
  paid        Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?
  paymentTerms String?   @map("payment_terms")
  plannedAd      Decimal @default(0) @map("planned_ad") @db.Decimal(14, 2)
  plannedVendor  Decimal @default(0) @map("planned_vendor") @db.Decimal(14, 2)
  plannedTools   Decimal @default(0) @map("planned_tools") @db.Decimal(14, 2)
  plannedPeople  Decimal @default(0) @map("planned_people") @db.Decimal(14, 2)
  discountPct    Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmt    Decimal @default(0) @map("discount_amt") @db.Decimal(14, 2)
  costingJson    String? @map("costing_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  client     Client      @relation(fields: [clientId], references: [id])
  lead       Lead?       @relation(fields: [leadId], references: [id])
  engagement Engagement? @relation(fields: [engagementId], references: [id])
  owner      User?       @relation("InvoiceOwner", fields: [ownerUserId], references: [id])
  lines      InvoiceLine[]

  @@index([clientId, status])
  @@map("invoices")
}

model InvoiceLine {
